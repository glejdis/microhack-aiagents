<mxfile host="app.diagrams.net" modified="2026-07-20T00:00:00.000Z" agent="clm-microhack" version="24.0.0">
  <diagram id="UserJourney" name="UserJourney">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Contract Manager journey — Agentic CLM on Microsoft Foundry" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="persona" value="👤  Persona: a Legal / Procurement contract manager at Contoso Global — buried in intake, clause review &amp;amp; renewals. They live in Microsoft 365 Copilot &amp;amp; Teams; a GPT-4.1 orchestrator (C3) routes each request to the right specialist agent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8a8a8a;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1424" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s0" value="&lt;b&gt;1 · Request a draft&lt;/b&gt;&lt;br&gt;&lt;br&gt;“Draft a mutual NDA with Acme, 2-yr term.”  The Intake &amp;amp; Drafting agent (Claude Sonnet 4.5) retrieves an approved template, fills in the details you give it and cites its sources — never inventing legal terms.&lt;br&gt;&lt;br&gt;&lt;i&gt;Built in C1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBDDF7;strokeColor=#7A4FB5;fontColor=#111111;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="224" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;2 · Check their draft&lt;/b&gt;&lt;br&gt;&lt;br&gt;Uploads Acme’s counter-draft MSA. The Clause &amp;amp; Risk agent (Claude Sonnet 4.5) extracts each clause, compares it to the Standard Clause Library, flags deviations and returns a risk score — with citations.&lt;br&gt;&lt;br&gt;&lt;i&gt;Built in C3&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBDDF7;strokeColor=#7A4FB5;fontColor=#111111;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="150" width="224" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="s0" target="s1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;3 · Ask, with citations&lt;/b&gt;&lt;br&gt;&lt;br&gt;“What’s our standard indemnity cap?”  Foundry IQ — agentic retrieval over Azure AI Search — answers over the Contoso corpus, grounded and with sources.&lt;br&gt;&lt;br&gt;&lt;i&gt;Built in C1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#E8590C;fontColor=#111111;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="224" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;4 · Review &amp;amp; sign off&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reads the flags and citations, edits, approves. Human-in-the-loop — nothing is finalized without sign-off; off-template or high-risk terms route to the required approver per the delegation-of-authority matrix.&lt;br&gt;&lt;br&gt;&lt;i&gt;Built in C1 · C3&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D3F9D8;strokeColor=#2F9E44;fontColor=#111111;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="150" width="224" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;5 · Track obligations&lt;/b&gt;&lt;br&gt;&lt;br&gt;The Obligation &amp;amp; Renewal agent (GPT-4o-mini) looks up contract status &amp;amp; upcoming renewals via function tools — backed by Azure SQL, with a seed-data fallback. Read-only: the tools query, they don’t write.&lt;br&gt;&lt;br&gt;&lt;i&gt;Built in C4 · tools/MCP in C3&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE4FA;strokeColor=#0078D4;fontColor=#111111;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="150" width="224" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;6 · Proactive alert&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ahead of the renewal date (configurable look-ahead; demo alert default 30 days), a Bot Framework proactive message pings the manager in Teams — alert text generated by the GPT-4o-mini renewal agent. Renew or renegotiate in time; no missed auto-renewals.&lt;br&gt;&lt;br&gt;&lt;i&gt;Built in C4&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5F0F0;strokeColor=#0C8599;fontColor=#111111;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="150" width="224" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="trust" value="🔒  Under the hood, every step runs in one Microsoft Foundry project — a GPT-4.1 orchestrator routing to Claude &amp;amp; GPT specialists, traced to Application Insights &amp;amp; scored by evaluations (C2), exposed as MCP tools (C3), and guarded by Content Safety / red-teaming (bonus C5).  Multi-model fleet: Claude Sonnet 4.5 (drafting + clause &amp;amp; risk) · GPT-4.1 (orchestrator) · GPT-4o-mini (renewal)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#0078D4;fontColor=#1F3864;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1424" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="legtitle" value="Colour = which model / role powers the step:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#5A5A66;" vertex="1" parent="1">
          <mxGeometry x="40" y="536" width="360" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBDDF7;strokeColor=#7A4FB5;" vertex="1" parent="1">
          <mxGeometry x="40" y="562" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg1t" value="Claude agent (Sonnet 4.5)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B1A19;" vertex="1" parent="1">
          <mxGeometry x="66" y="562" width="220" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE4FA;strokeColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="300" y="562" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg2t" value="GPT agent (4.1 · 4o-mini)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B1A19;" vertex="1" parent="1">
          <mxGeometry x="326" y="562" width="220" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#E8590C;" vertex="1" parent="1">
          <mxGeometry x="560" y="562" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg3t" value="Foundry IQ / tools" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B1A19;" vertex="1" parent="1">
          <mxGeometry x="586" y="562" width="180" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D3F9D8;strokeColor=#2F9E44;" vertex="1" parent="1">
          <mxGeometry x="780" y="562" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg4t" value="Human sign-off (HITL)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B1A19;" vertex="1" parent="1">
          <mxGeometry x="806" y="562" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5F0F0;strokeColor=#0C8599;" vertex="1" parent="1">
          <mxGeometry x="1020" y="562" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg5t" value="Proactive Teams alert" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B1A19;" vertex="1" parent="1">
          <mxGeometry x="1046" y="562" width="220" height="20" as="geometry"/>
