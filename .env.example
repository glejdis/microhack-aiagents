# ==========================================================================
# Foundry CLM Microhack — environment template
# Copy to `.env` (never commit `.env`). Challenge 0's deploy script autofills
# most of these for you. Fill the Bot values in Challenge 4.
# ==========================================================================

# --- Foundry project ------------------------------------------------------
# Project endpoint, copied from the Foundry portal (Overview → Endpoint).
# Example: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=

# --- Model deployments (multi-model fleet) --------------------------------
# Deployment names you created in Challenge 0. Two specialists run on Claude
# (GA in Microsoft Foundry); the orchestrator + lightweight agent run on GPT.
MODEL_ORCHESTRATOR=gpt-4.1
MODEL_DRAFTING=claude-sonnet-4-5
MODEL_CLAUSE_RISK=claude-sonnet-4-5
MODEL_RENEWAL=gpt-4o-mini

# --- Azure AI Search (Foundry IQ knowledge base) --------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=clm-corpus
AZURE_SEARCH_CONNECTION_NAME=clm-search

# --- Storage (corpus source docs) -----------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=clm-corpus

# --- Observability (Challenge 2) ------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Capture prompt/response content in traces (dev only — PII implications).
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true

# --- Azure SQL (contract status / renewal dates function tool) ------------
AZURE_SQL_CONNECTION_STRING=

# --- Publish + proactive Teams alerts (Challenge 4) -----------------------
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
# Captured from an inbound Teams activity; used to push proactive alerts.
TEAMS_SERVICE_URL=
TEAMS_CONVERSATION_ID=
